# ─────────────────────────────────────────────────────────────────────────────
# Boostr Netwave Solutions — Client Environment Variables
# Copy this file to .env.local for local dev, or set in Vercel dashboard for prod.
# NEVER commit .env.local or .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# In development: leave BLANK — Vite automatically proxies /api → localhost:5000
# In production: set to your deployed backend URL on Render/Railway/etc.
# Example: VITE_API_URL=https://api.boostrnetwave.com
VITE_API_URL=

# ── Analytics (Optional) ──────────────────────────────────────────────────────
# Add Google Analytics, PostHog, etc. keys here if needed in future
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
