# ─────────────────────────────────────────────────────────────────────────────
# Boostr Netwave Solutions — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=Boostr Netwave Solutions API

# ── Database (REQUIRED — server will not start without this) ──────────────────
# Get from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/boostr-netwave?retryWrites=true&w=majority

# ── JWT (REQUIRED — auth will not work without this) ──────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_64_CHAR_RANDOM_HEX_STRING_NEVER_SHARE_THIS
JWT_EXPIRES_IN=7d

# ── CORS (REQUIRED — API requests will be blocked without this) ───────────────
# Dev: http://localhost:5173 | Prod: https://boostrnetwave.com
CLIENT_ORIGIN=http://localhost:5173

# ── Cloudinary (Optional — uploads degrade gracefully if missing) ─────────────
# Get from: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email via Resend (Optional — emails degrade gracefully if missing) ────────
# Get from: https://resend.com/api-keys  (free tier: 3000 emails/month)
RESEND_API_KEY=re_your_api_key_here
# Admin inbox for contact form alert emails
CONTACT_ALERT_EMAIL=contact@boostrnetwave.com
# "From" address (must match your verified Resend domain)
EMAIL_FROM="Boostr Netwave" <hello@boostrnetwave.com>

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Public Site URL ───────────────────────────────────────────────────────────
# Used in sitemap.xml and email template links
# Dev: http://localhost:5000 | Prod: https://boostrnetwave.com
PUBLIC_SITE_URL=http://localhost:5000
